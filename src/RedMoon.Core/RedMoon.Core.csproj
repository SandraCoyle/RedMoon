<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RedMoon.Core indeholder AL forretningslogik, datamodel, kryptering og lagring.
    - netstandard2.1: gør biblioteket kompatibelt med Unity (2021.2+) og alle .NET-platforme.
    - net10.0: bruges af MAUI-appen og testene (giver hurtigere, native PBKDF2).
    Biblioteket har INGEN eksterne NuGet-afhængigheder – kun .NET's indbyggede kryptografi.
  -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
    <RootNamespace>RedMoon.Core</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Unity understøtter højst C# 9. Låses her, så nye sprogfeatures ikke sniger sig ind og bryder Unity-importen. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <LangVersion>9.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RedMoon.Core.Tests" />
  </ItemGroup>

</Project>
