<?xml version="1.0" encoding="utf-8" ?>
<!-- Skift mønster -->
<ContentPage
    x:Class="RedMoon.App.Views.ChangePatternPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:RedMoon.App.Controls"
    xmlns:vm="clr-namespace:RedMoon.App.ViewModels"
    x:DataType="vm:ChangePatternViewModel"
    Shell.TabBarIsVisible="False"
    Shell.NavBarIsVisible="True"
    Title="Skift mønster">

    <VerticalStackLayout Padding="24" Spacing="12" VerticalOptions="Center">
        <Label Text="{Binding StepText}" Style="{StaticResource CaptionLabel}" HorizontalOptions="Center" />
        <Label Text="{Binding Title}" Style="{StaticResource TitleLabel}" FontSize="22" HorizontalTextAlignment="Center" />
        <Grid HeightRequest="300">
            <controls:PatternLockView PatternCompletedCommand="{Binding PatternCompletedCommand}"
                                      IsError="{Binding IsPatternError}"
                                      HeightRequest="300" WidthRequest="300" HorizontalOptions="Center" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>
        <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorLabel}" />
    </VerticalStackLayout>
</ContentPage>
