<?xml version="1.0" encoding="utf-8"?>
<!--
	Privatliv:
	- INGEN <uses-permission>: appen beder ikke om internet, lokation, kontakter, kamera osv.
	  (Debug-builds får automatisk INTERNET tilføjet af .NET for at debuggeren kan forbinde. Release-builds gør ikke.)
	- allowBackup=false + dataExtractionRules: data kopieres ikke til Google-backup eller ved enhed-til-enhed-overførsel.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<application
		android:allowBackup="false"
		android:fullBackupContent="false"
		android:dataExtractionRules="@xml/data_extraction_rules"
		android:icon="@mipmap/appicon"
		android:roundIcon="@mipmap/appicon_round"
		android:supportsRtl="true"
		android:label="Rød Måne">
	</application>
</manifest>
